    <string name="grant_access">Nadaj dostęp</string>
    <string name="game_needs_extended">Gry z emulatorów (nazwa ROM-u i okładka) są rozpoznawane w trybie rozszerzonym. Bez niego tylko gry na Androida.</string>
    <string name="game_none">Na górnym ekranie nie ma teraz gry - gałki świecą stałym kolorem.</string>
